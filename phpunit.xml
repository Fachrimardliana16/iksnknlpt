<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        expose_php adalah setelan php.ini dan tidak dapat diubah lewat <env>.
        Di server, setel "expose_php = Off" di php.ini (atau jalankan artisan
        serve dengan -d expose_php=0). Test HeaderPhpTest memeriksa nilai yang
        benar-benar berlaku pada proses ini, supaya header X-Powered-By tidak
        kembali tanpa ketahuan.
    -->
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:Fx8PzHZXrU4eKQbA8nJ2sV6yC0mDtLgRiW1oNuZkXcE="/>
        <env name="BLIND_INDEX_KEY" value="a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778899aabbccddeeff00"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <!--
            Basis data test memakai BERKAS SEMENTARA, bukan ":memory:".

            Alasannya bukan selera: PRAGMA journal_mode=WAL tidak berlaku untuk
            ":memory:", dan menjalankannya membuat Laravel membuang koneksi lalu
            membukanya ulang tanpa ":memory:" — memakai jalur dari konfigurasi,
            yaitu database/database.sqlite. Migrasi test karena itu berjalan di
            berkas KERJA dan menghapus isinya. Berkas sementara membuat WAL sah,
            dan tidak ada berkas kerja yang tersentuh.
        -->
        <env name="DB_DATABASE" value="database/testing.sqlite"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
