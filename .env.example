APP_NAME="Iksan Knalpot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=iksan

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="no-reply@iksanknalpot.test"
MAIL_FROM_NAME="${APP_NAME}"

# Blind index key for searchable encrypted columns (HMAC-SHA256).
# Generate: php artisan tinker --execute="echo bin2hex(random_bytes(32));"
BLIND_INDEX_KEY=

# Upload limits
UPLOAD_IMAGE_MAX_KB=5120
UPLOAD_VIDEO_MAX_KB=8192
UPLOAD_MAX_FILES_PER_PRODUCT=200
UPLOAD_MAX_TOTAL_MB_PER_PRODUCT=50
UPLOAD_PROCESSING_MEMORY_MB=256
UPLOAD_PROCESSING_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"
